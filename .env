# React App configurations
PORT=3000

REACT_APP_FHIR_URL=https://xia.edu.fyrstain.com/fhir
REACT_APP_EXTRACTED_URL=https://xia.edu.fyrstain.com/fhir
REACT_APP_QUESTIONNAIRE_URL=https://xia.edu.fyrstain.com/fhir
REACT_APP_CQL_URL=https://xia.edu.fyrstain.com/fhir
REACT_APP_CDSHOOKS_URL=https://xia.edu.fyrstain.com
REACT_APP_TERMINOLOGY_URL=https://xia.edu.fyrstain.com/fhir

REACT_APP_CLIENT_LOGO=https://www.fluteproject.eu/theme/FluteEu/img/logo.png
REACT_APP_CLIENT_LOGO_LINK=https://hl7.eu
REACT_APP_DISPLAY_CLIENT_LOGO=true

PUBLIC_URL=/sphinx

# Keycloak
REACT_APP_KEYCLOAK_URL=https://sandbox.hl7europe.eu/keycloak-flute
REACT_APP_REDIRECTURI=http://localhost:3000/sphinx
REACT_APP_KEYCLOAK_REALM=demo
REACT_APP_KEYCLOAK_REALM_CLIENT_ID=pandora-demo
REACT_APP_KEYCLOAK_FLOW=standard
REACT_APP_KEYCLOAK_ONLOAD=check-sso
REACT_APP_KEYCLOAK_CHECKSSO_LOGIN_IFRAME=false
REACT_APP_KEYCLOAK_CHECKSSO_FALLBACK=false
REACT_APP_KEYCLOAK_PKCE_METHOD=S256

# Keycloak container configuration
KEYCLOAK_PORT=8999

# Source map
GENERATE_SOURCEMAP=false